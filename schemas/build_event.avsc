{
  "type": "record",
  "name": "BuildEvent",
  "namespace": "io.watchtower.events",
  "doc": "One build-farm event as emitted by a build agent: a build starting or finishing, a compiler invocation, a test run, a dependency fetch, an artifact upload. Registered under subject security-logs-value (the name predates the compilation-log pivot and is kept so topics, tables and the registry stay put) with BACKWARD compatibility: a new version may only add fields that carry a default.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID, the dedup key"
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO-8601 with offset. Kept as a string: the validate step casts it, so a malformed value is rejected with a reason rather than nulled at decode time"
    },
    {
      "name": "runner_ip",
      "type": "string",
      "doc": "The build agent that emitted the event. The stream is keyed by it, so every window feature is about one runner"
    },
    {
      "name": "project",
      "type": "string",
      "doc": "The project being built (repository / module name)"
    },
    {
      "name": "event_type",
      "type": "string"
    },
    {
      "name": "hostname",
      "type": "string",
      "doc": "The runner's hostname"
    },
    {
      "name": "severity",
      "type": "string"
    },
    {
      "name": "reason",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "BUILD_FAILURE only: compile_error | link_error | test_failure | oom_killed | timeout | dependency_unresolved | toolchain_error"
    },
    {
      "name": "command",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "COMPILE_STEP only: the compiler or linker invocation"
    },
    {
      "name": "exit_code",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Process exit status (COMPILE_STEP, TEST_RUN, BUILD_FAILURE). 137 is SIGKILL -- what the OOM killer sends"
    },
    {
      "name": "log_source",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Emitting tool: make, ninja, gradle, maven, cargo, npm, go, bazel, registry, jenkins"
    },
    {
      "name": "outcome",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "success | failure | cancelled | skipped"
    },
    {
      "name": "build_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Correlates the events of one build"
    },
    {
      "name": "dest_ip",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Where the fetch or upload went: artifact registry, cache or store"
    },
    {
      "name": "dest_port",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Destination port"
    },
    {
      "name": "protocol",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "https | http | grpc | tcp"
    },
    {
      "name": "triggered_by",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Who or what started the build: a developer, a CI account, a schedule"
    },
    {
      "name": "http_method",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "GET, PUT, ..."
    },
    {
      "name": "url_path",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Path AND query string of a registry request, as received"
    },
    {
      "name": "http_status",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Registry response status code"
    },
    {
      "name": "user_agent",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Client tool and version, e.g. maven/3.9.6"
    },
    {
      "name": "bytes_sent",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Bytes transferred by the fetch or upload -- large uploads from one runner fill the artifact store"
    },
    {
      "name": "response_time_ms",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Registry latency"
    },
    {
      "name": "process_name",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Executable that ran: gcc, clang++, rustc, javac, ld, ..."
    },
    {
      "name": "process_id",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "PID"
    },
    {
      "name": "parent_process",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Parent executable -- ninja -> clang++ is the usual shape; sh -> curl -> sh is not"
    },
    {
      "name": "process_uid",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Effective uid. 0 is root. Null means unknown -- never assume root"
    },
    {
      "name": "step",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "COMPILE_STEP kind: compile | link | archive | codegen"
    },
    {
      "name": "file_path",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Source file or artifact the step worked on"
    },
    {
      "name": "duration_ms",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "How long the step, test run or build took"
    },
    {
      "name": "peak_memory_mb",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Peak resident memory of the step"
    },
    {
      "name": "cache_status",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Build-cache lookup: hit | miss | corrupt"
    },
    {
      "name": "error_message",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "First line of the tool's error output, if any"
    },
    {
      "name": "scenario",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Simulation ground truth. Never read by the pipeline; exists only so detection can be evaluated"
    }
  ]
}
