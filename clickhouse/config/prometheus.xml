<!-- Dev (docker compose): ClickHouse's own Prometheus endpoint, as in
     Kubernetes (deploy/k8s/base/clickhouse.yaml). Scraped by the compose
     Prometheus (profile: monitoring); inside the compose network only. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
