{
  "uid": "watchtower",
  "title": "Watchtower pipeline",
  "tags": [
    "watchtower"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Streaming path (Flink): is every event decided in time?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka -> decision latency",
      "description": "Rolling over the last 2,000 events per subtask. End to end (with the ClickHouse insert): `make latency`.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_p50_ms)",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_p95_ms)",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_max_ms)",
          "legendFormat": "max",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka backlog (events waiting)",
      "description": "Grows only if the job reads slower than events arrive; the autoscaler adds TaskManagers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_operator_KafkaSourceReader_KafkaConsumer_records_lag_max)",
          "legendFormat": "lag",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Decisions per second",
      "description": "Every event gets exactly one decision; rejected = malformed, kept in rejected_events.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_ok[1m]))",
          "legendFormat": "ok",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_alert[1m]))",
          "legendFormat": "alert",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_quarantine[1m]))",
          "legendFormat": "quarantine",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_rejected_events[1m]))",
          "legendFormat": "rejected",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TaskManagers (autoscaled)",
      "description": "Started and stopped by the Flink operator's job autoscaler.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job=\"watchtower-stream\", component=\"taskmanager\"} == 1)",
          "legendFormat": "taskmanagers",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Data quality between steps (events/min)",
      "description": "Events flagged at each transformation boundary (etl/core/dq.py). normalize/enrich: doubtful but kept (defaulted severity, no project, unplaced runner, clock off). features/rules: contradictions -- should always be zero. validate: rejected, by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(sum by (__name__) (rate({__name__=~\"flink_taskmanager_job_task_operator_watchtower_dq_.+\"}[5m])) * 60, \"issue\", \"$1\", \"__name__\", \"flink_taskmanager_job_task_operator_watchtower_dq_(.+)\")",
          "legendFormat": "{{issue}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ML model: decisions it raised (per min)",
      "description": "Events whose decision the LightGBM model raised above what the rules said (watchtower.security_events.ml_reason is set). Per model version and hour: the ClickHouse views ml_decisions_hourly and ml_model_review.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_ml_raised[5m])) * 60",
          "legendFormat": "raised by the model",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 110,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 111,
      "type": "stat",
      "title": "Brokers up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"kafka\", pool=\"brokers\"} == 1)",
          "legendFormat": "brokers"
        }
      ]
    },
    {
      "id": 112,
      "type": "stat",
      "title": "Under-replicated partitions",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 34,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_server_replicamanager_underreplicatedpartitions)",
          "legendFormat": "under-replicated"
        }
      ]
    },
    {
      "id": 113,
      "type": "timeseries",
      "title": "Messages in per broker",
      "description": "After scaling brokers, load only spreads once partitions are rebalanced.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(kafka_server_brokertopicmetrics_messagesin_total[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 114,
      "type": "timeseries",
      "title": "Partitions led per broker",
      "description": "Uneven after a scale-up until rebalance-topic.sh runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (kafka_server_replicamanager_leadercount)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 115,
      "type": "timeseries",
      "title": "ClickHouse rows inserted per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ClickHouseProfileEvents_InsertedRows[1m])",
          "legendFormat": "inserted"
        }
      ]
    }
  ]
}
