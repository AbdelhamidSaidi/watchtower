{
  "uid": "watchtower",
  "title": "Watchtower pipeline",
  "tags": [
    "watchtower"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Streaming path (Flink): is every event decided in time?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka -> decision latency",
      "description": "Rolling over the last 2,000 events per subtask. End to end (with the ClickHouse insert): `make latency`.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_p50_ms)",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_p95_ms)",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(flink_taskmanager_job_task_operator_watchtower_kafka_to_scored_max_ms)",
          "legendFormat": "max",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka backlog (events waiting)",
      "description": "Grows only if the job reads slower than events arrive; the autoscaler adds TaskManagers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_operator_KafkaSourceReader_KafkaConsumer_records_lag_max)",
          "legendFormat": "lag",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Decisions per second",
      "description": "Every event gets exactly one decision; rejected = malformed, kept in rejected_events.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_allow[1m]))",
          "legendFormat": "allow",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_alert[1m]))",
          "legendFormat": "alert",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_action_block[1m]))",
          "legendFormat": "block",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_watchtower_rejected_events[1m]))",
          "legendFormat": "rejected",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TaskManagers (autoscaled)",
      "description": "Started and stopped by the Flink operator's job autoscaler.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(up{job=\"watchtower-stream\", component=\"taskmanager\"} == 1)",
          "legendFormat": "taskmanagers",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Spark path (optional component)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "row",
      "title": "Is it keeping up?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Throughput: arriving vs processed",
      "description": "Processed below arriving for a sustained period means lag is building.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_input_rows_per_second",
          "legendFormat": "in \u00b7 {{query}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_processed_rows_per_second",
          "legendFormat": "processed \u00b7 {{query}}"
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Batch duration vs trigger interval",
      "description": "Above the trigger line = falling behind (BatchFallingBehind alert).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_batch_duration_seconds",
          "legendFormat": "batch \u00b7 {{query}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_trigger_interval_seconds",
          "legendFormat": "trigger interval"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Kafka lag (worst partition)",
      "description": "From Spark's own progress events -- Spark does not commit to consumer groups, so kafka-exporter cannot see this.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_kafka_offsets_behind_latest",
          "legendFormat": "{{query}}"
        }
      ]
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "State store",
      "description": "Dedup + feature state. Bounded by the watermark; steady growth means it is not being evicted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "watchtower_state_rows",
          "legendFormat": "rows \u00b7 {{query}}"
        }
      ]
    },
    {
      "id": 106,
      "type": "row",
      "title": "Is detection working?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "Detection outcomes per second",
      "description": "'error' means events passed unjudged -- detection fails open. 'disabled' means no API key.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(watchtower_detection_outcomes_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "Suspicious events per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(watchtower_suspicious_events_total[5m]) * 60",
          "legendFormat": "suspicious / min"
        }
      ]
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Rows written per second",
      "description": "rejected_events above zero means a source is sending malformed or unregistered data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (table) (rate(watchtower_rows_written_total[1m]))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 110,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 111,
      "type": "stat",
      "title": "Brokers up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"kafka\", pool=\"brokers\"} == 1)",
          "legendFormat": "brokers"
        }
      ]
    },
    {
      "id": 112,
      "type": "stat",
      "title": "Under-replicated partitions",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 53,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_server_replicamanager_underreplicatedpartitions)",
          "legendFormat": "under-replicated"
        }
      ]
    },
    {
      "id": 113,
      "type": "timeseries",
      "title": "Messages in per broker",
      "description": "After scaling brokers, load only spreads once partitions are rebalanced.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(kafka_server_brokertopicmetrics_messagesin_total[1m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 114,
      "type": "timeseries",
      "title": "Partitions led per broker",
      "description": "Uneven after a scale-up until rebalance-topic.sh runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (kafka_server_replicamanager_leadercount)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 115,
      "type": "timeseries",
      "title": "ClickHouse rows inserted per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 61,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(ClickHouseProfileEvents_InsertedRows[1m])",
          "legendFormat": "inserted"
        }
      ]
    }
  ]
}